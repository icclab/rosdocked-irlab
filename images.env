# Single source of truth for image names, sourced by every build script and by
# the Jenkinsfile. Previously each build script hardcoded its own tag and the
# Jenkinsfile pushed a different (noetic) set entirely, so CI built jazzy and
# published noetic for months.
#
# Override any of these from the environment, e.g.:
#   IMAGE_TAG=jazzy-$(git rev-parse --short HEAD) ./build_k8s_with_workspace.sh

REGISTRY=${REGISTRY:-robopaas}
ROS_DISTRO=${ROS_DISTRO:-jazzy}

# CPU images
IMAGE_TAG=${IMAGE_TAG:-latest}

# K8S/GPU images. NOTE: "cuda12.5.0" is legacy and misleading -- nothing in the
# image is tied to a CUDA version any more (nvidia-cuda-toolkit was removed and
# libcuda.so is injected by nvidia-container-toolkit at runtime). Move this to
# something like jazzy-$(git rev-parse --short HEAD) once the k8s manifests that
# reference the old tag have been updated.
K8S_TAG=${K8S_TAG:-cuda12.5.0}

# The NVIDIA userspace driver version baked into the K8S image. It MUST match the
# driver on the RAP nodes (check with `nvidia-smi` on a node). Leave empty to skip
# the bake: every pod then installs the matching driver on first start, and the
# image can be built on a machine with no GPU. Either way entrypoint.sh re-installs
# at start if the node's driver has changed, so an upgraded cluster keeps working.
NVIDIA_DRIVER_VERSION=${NVIDIA_DRIVER_VERSION:-}

BASE_CPU_IMAGE=${REGISTRY}/rosdocked-${ROS_DISTRO}-base-cpu:${IMAGE_TAG}
CPU_IMAGE=${REGISTRY}/rosdocked-${ROS_DISTRO}-cpu:${IMAGE_TAG}
BASE_K8S_IMAGE=${REGISTRY}/rosdocked-${ROS_DISTRO}-base-k8s:${K8S_TAG}
K8S_IMAGE=${REGISTRY}/rosdocked-${ROS_DISTRO}-k8s:${K8S_TAG}
RAP_IMAGE=${REGISTRY}/rap-${ROS_DISTRO}:${K8S_TAG}
