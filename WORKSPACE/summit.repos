# Source packages for the Summit XL workspace, imported with vcstool.
# Same repos and branches as the `git clone` block in WORKSPACE/Dockerfile;
# keep the two in sync.
repositories:
  summit_xl_common:
    type: git
    url: https://github.com/icclab/summit_xl_common.git
    version: humble
  icclab_summit_xl:
    type: git
    url: https://github.com/icclab/icclab_summit_xl.git
    version: jazzy
  ros2_laser_scan_merger:
    type: git
    url: https://github.com/icclab/ros2_laser_scan_merger.git
    version: jazzy
  ros2_robotiq_gripper:
    type: git
    url: https://github.com/PickNikRobotics/ros2_robotiq_gripper.git
    version: main
